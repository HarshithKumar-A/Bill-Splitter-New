// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String   @id @default(cuid())
  name       String
  email      String   @unique
  password   String?  // Optional: null for OAuth users
  provider   String   @default("credentials") // "credentials" or "google"
  providerId String?  // Google UID or other OAuth provider ID
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  groups    GroupMember[]
  expenses  Expense[]     @relation("PaidBy")
  shares    ExpenseShare[]
  createdPlanItems ItineraryItem[] @relation("PlanItemCreator")

  @@index([email])
  @@index([providerId])
}

model Group {
  id          String   @id @default(cuid())
  name        String
  destination String   @default("Not specified")
  description String?
  startDate   DateTime @default(now())
  endDate     DateTime @default(now())
  currency    String   @default("INR")
  status      String   @default("ACTIVE") // PLANNING, ACTIVE, COMPLETED, ARCHIVED
  coverImage  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  members   GroupMember[]
  expenses  Expense[]
  planItems ItineraryItem[]
}

model GroupMember {
  id        String   @id @default(cuid())
  groupId   String
  userId    String
  createdAt DateTime @default(now())

  // Relations
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
}

model Expense {
  id            String   @id @default(cuid())
  title         String
  amount        Float
  category      String
  date          DateTime @default(now())
  groupId       String
  paidById      String
  paidByTheirOwn Boolean @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  group         Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  paidBy        User     @relation("PaidBy", fields: [paidById], references: [id])
  shares        ExpenseShare[]
  linkedPlanItem ItineraryItem? @relation("PlanItemExpense")
}

enum PlanItemType {
  STAY
  TRAVEL
  ACTIVITY
}

model ItineraryItem {
  id              String       @id @default(cuid())
  groupId         String
  createdById     String?
  type            PlanItemType
  title           String
  locationFrom    String?
  locationTo      String?
  startDate       DateTime
  endDate         DateTime?
  startTime       String?
  endTime         String?
  bookingRef      String?
  notes           String?
  participantIds  String[]     @default([])
  linkedExpenseId String?      @unique
  sortOrder       Int          @default(0)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  group           Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdBy       User?        @relation("PlanItemCreator", fields: [createdById], references: [id], onDelete: SetNull)
  linkedExpense   Expense?     @relation("PlanItemExpense", fields: [linkedExpenseId], references: [id], onDelete: SetNull)

  @@index([groupId, startDate, startTime, sortOrder])
}

model ExpenseShare {
  id          String   @id @default(cuid())
  expenseId   String
  userId      String
  amount      Float
  createdAt   DateTime @default(now())

  // Relations
  expense     Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id])

  @@unique([expenseId, userId])
}
